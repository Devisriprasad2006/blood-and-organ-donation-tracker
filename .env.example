# LifeLink Digital Blood & Organ Donation Management and Tracking System
# Template Environment Configuration

PORT=5000
NODE_ENV=production

# MySQL 8 Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_NAME=lifelink_db

# Security & Authentication
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=24h

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Emergency SOS & Notifications
NOTIFICATION_EMAIL_SIMULATION=true
NOTIFICATION_SMS_SIMULATION=true
BACKGROUND_MONITORING_INTERVAL_MS=30000

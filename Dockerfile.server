# =============================================================================
# Production Dockerfile for LifeLink Node.js Express & Socket.IO Backend Server
# =============================================================================

FROM node:24-alpine AS builder

WORKDIR /app

# Copy dependency definitions
COPY package*.json tsconfig*.json ./

# Install dependencies
RUN npm ci

# Copy server and shared source code
COPY server ./server

# Build / bundle if needed or run with node in production image
FROM node:24-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=5000

# Copy node_modules and code from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/server ./server
COPY tsconfig*.json ./

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/v1/health || exit 1

# Start production server
CMD ["node", "--loader", "tsx", "server/src/index.ts"]
